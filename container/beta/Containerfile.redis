# ACC Redis — support-tier-aware build (beta)
#
# See container/production/Containerfile.redis for the full support-tier note.
# In short: `redis` has no subscription-free RPM on RHEL 9 (it's entitled
# AppStream, not in EPEL nor the UBI mirror), so the two tiers use different
# bases but produce the same ACC contract (redis on :6379, non-root UID 1001):
#
#   upstream (DEFAULT) — community image docker.io/library/redis (no subscription).
#   rhel               — entitled RHEL AppStream redis RPM on UBI9 minimal
#                        (needs a subscribed build host / mounted entitlement).

# Base derived from the tier (upstream → community redis; rhel → UBI9 minimal).
ARG REDIS_BASE=docker.io/library/redis:7.2
FROM ${REDIS_BASE}

ARG ACC_SUPPORT_TIER=upstream

LABEL name="acc-redis" \
      version="7" \
      summary="Redis 7 for ACC standalone deployment" \
      description="Redis 7 for ACC (support tier: ${ACC_SUPPORT_TIER})." \
      com.redhat.acc.support-tier="${ACC_SUPPORT_TIER}"

USER 0

# rhel → install the entitled AppStream redis RPM; upstream → community base
# already ships it. Assert the binaries either way.
RUN set -eux; \
    case "${ACC_SUPPORT_TIER}" in \
      rhel) \
        microdnf install -y redis; \
        microdnf clean all; \
        rm -rf /var/cache/dnf ;; \
      upstream) \
        : ;; \
      *) \
        echo "ERROR: ACC_SUPPORT_TIER must be 'upstream' or 'rhel', got '${ACC_SUPPORT_TIER}'" >&2; \
        exit 2 ;; \
    esac; \
    command -v redis-server; \
    command -v redis-cli

# Create data directory with correct ownership for non-root UID 1001.
RUN mkdir -p /var/lib/redis/data \
    && chown -R 1001:0 /var/lib/redis \
    && chmod -R g=u /var/lib/redis

# Minimal redis.conf: bind all interfaces, disable protected-mode for
# container-internal use, persist data to the mounted volume.
# requirepass is injected at runtime via the entrypoint when REDIS_PASSWORD is set.
RUN printf '\
bind 0.0.0.0\n\
protected-mode no\n\
dir /var/lib/redis/data\n\
save 900 1\n\
save 300 10\n\
save 60 10000\n\
loglevel notice\n\
logfile ""\n\
' > /etc/redis.conf

# Entrypoint: start redis-server, appending --requirepass when REDIS_PASSWORD is set.
RUN printf '#!/bin/sh\nexec redis-server /etc/redis.conf ${REDIS_PASSWORD:+--requirepass "$REDIS_PASSWORD"}\n' \
    > /usr/local/bin/redis-entrypoint.sh \
    && chmod +x /usr/local/bin/redis-entrypoint.sh

# Healthcheck: authenticates with REDIS_PASSWORD when set, else unauthenticated ping.
RUN printf '#!/bin/sh\nexec redis-cli -h 127.0.0.1 ${REDIS_PASSWORD:+-a "$REDIS_PASSWORD"} ping\n' \
    > /usr/local/bin/redis-healthcheck.sh \
    && chmod +x /usr/local/bin/redis-healthcheck.sh

# Run as non-root (OCP restricted SCC compatible).
USER 1001

EXPOSE 6379

VOLUME ["/var/lib/redis/data"]

ENTRYPOINT ["/usr/local/bin/redis-entrypoint.sh"]
